              },
              "helpUri": "https://github.com/RudyG07/p-token-migrator",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "spl-token-close_account",
              "name": "SplTokenCloseAccount",
              "shortDescription": {
                "text": "SPL Token `close_account` CPI call site"
              },
              "fullDescription": {
                "text": "Detects an SPL Token `close_account` CPI call site that is a candidate for migration to p-token / verification under Token-2022. The analyzer emits the legacy and target compute-unit costs plus a generated replacement snippet alongside each finding."
              },
              "helpUri": "https://github.com/RudyG07/p-token-migrator",
