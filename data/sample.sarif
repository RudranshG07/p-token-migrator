          ]
        },
        {
          "ruleId": "spl-token-burn",
          "level": "error",
          "message": {
            "text": "burn: Signer seeds and a token_program account are present — PDA authority and program-account switching both need manual confirmation.. Legacy CU 5700 → target 250 (saved 5450, 95.6%)."
