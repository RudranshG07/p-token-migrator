{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "solana-token-analyzer",
          "version": "0.1.0",
          "informationUri": "https://github.com/RudyG07/p-token-migrator",
          "rules": [
            {
              "id": "spl-token-transfer",
              "name": "SplTokenTransfer",
              "shortDescription": {
                "text": "SPL Token `transfer` CPI call site"
              },
              "fullDescription": {
                "text": "Detects an SPL Token `transfer` CPI call site that is a candidate for migration to p-token / verification under Token-2022. The analyzer emits the legacy and target compute-unit costs plus a generated replacement snippet alongside each finding."
              },
              "helpUri": "https://github.com/RudyG07/p-token-migrator",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "spl-token-mint_to",
              "name": "SplTokenMintTo",
              "shortDescription": {
                "text": "SPL Token `mint_to` CPI call site"
              },
              "fullDescription": {
                "text": "Detects an SPL Token `mint_to` CPI call site that is a candidate for migration to p-token / verification under Token-2022. The analyzer emits the legacy and target compute-unit costs plus a generated replacement snippet alongside each finding."
              },
              "helpUri": "https://github.com/RudyG07/p-token-migrator",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "spl-token-burn",
              "name": "SplTokenBurn",
