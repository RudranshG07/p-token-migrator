          ]
        }
      },
      "results": [
        {
          "ruleId": "spl-token-transfer",
          "level": "error",
          "message": {
            "text": "transfer: Signer seeds and a token_program account are present — PDA authority and program-account switching both need manual confirmation.. Legacy CU 5200 → target 220 (saved 4980, 95.8%)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "programs/vault/src/lib.rs"
                },
                "region": {
                  "startLine": 17
                }
              }
            }
          ]
        },
        {
          "ruleId": "spl-token-mint_to",
          "level": "error",
          "message": {
            "text": "mint_to: Signer seeds and a token_program account are present — PDA authority and program-account switching both need manual confirmation.. Legacy CU 6100 → target 260 (saved 5840, 95.7%)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "programs/vault/src/lib.rs"
                },
                "region": {
                  "startLine": 30
