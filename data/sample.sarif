            {
              "id": "spl-token-initialize_account",
              "name": "SplTokenInitializeAccount",
              "shortDescription": {
                "text": "SPL Token `initialize_account` CPI call site"
              },
              "fullDescription": {
                "text": "Detects an SPL Token `initialize_account` CPI call site that is a candidate for migration to p-token / verification under Token-2022. The analyzer emits the legacy and target compute-unit costs plus a generated replacement snippet alongside each finding."
              },
              "helpUri": "https://github.com/RudyG07/p-token-migrator",
